{
  "name": "neobank-sprint",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "node --env-file-if-exists=.env.local scripts/push-schema.mjs",
    "test": "tsc src/lib/cards.ts src/lib/rules.ts src/lib/derive.ts src/lib/effects.ts src/lib/engine.ts --outDir .test-build --module commonjs --target ES2022 --moduleResolution node --skipLibCheck --esModuleInterop && node tests/engine.test.cjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.1",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "typescript": "^5.7.2"
  }
}
